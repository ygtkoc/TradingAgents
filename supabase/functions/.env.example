# ── Required for all Edge Functions ──────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=eyJ...          # Public anon key (safe for clients)
SUPABASE_SERVICE_ROLE_KEY=eyJ...  # SECRET — never expose to frontend

# ── API key encryption ────────────────────────────────────────────────────────
# 32+ character random secret for AES-256-GCM encryption of exchange API keys.
# Generate: openssl rand -base64 32
# TODO(production): Remove this in favour of Supabase Vault key reference.
API_KEY_ENCRYPTION_SECRET=change-me-to-32-plus-random-bytes-here

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
ALLOWED_ORIGINS=https://ornek.com,https://musteri.ornek.com,https://admin.ornek.com,http://localhost:3000,http://localhost:3001

# ── Stripe (required for stripe-webhook function only) ───────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
