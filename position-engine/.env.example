# ── Supabase ───────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # service_role key — never expose to clients

# ── API Key Encryption ─────────────────────────────────────────────────────────
# Must match the secret used by the Edge Function that encrypted the exchange keys.
API_KEY_ENCRYPTION_SECRET=your-32-char-secret-here-keep-this-safe

# ── Worker Identity ────────────────────────────────────────────────────────────
# Unique per replica. Auto-generated (exec-<uuid>) if not set.
POSITION_ENGINE_WORKER_ID=pos-worker-1

# ── Polling ────────────────────────────────────────────────────────────────────
POSITION_POLL_INTERVAL_SECONDS=5
POSITION_MAX_CONCURRENT_RUNS=5
POSITION_STALE_MINUTES=10
POSITION_MAX_RETRIES=3

# ── Live Close Gate ────────────────────────────────────────────────────────────
# CRITICAL: Keep false until all lifecycle safety checks are audited.
# Must also have platform_settings.emergency_close_enabled=true for emergency closes.
ENABLE_LIVE_CLOSE=false

# ── Queue ──────────────────────────────────────────────────────────────────────
USE_PGMQ=false

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Dry Run ────────────────────────────────────────────────────────────────────
# true = run all lifecycle logic but skip DB writes and exchange calls
DRY_RUN=false

# ── Risk Defaults ──────────────────────────────────────────────────────────────
# How long to tolerate an exchange order in an unknown state before marking
# needs_reconciliation (seconds).
ORDER_CONFIRMATION_TIMEOUT_SECONDS=30

# Fetch batch size per poll cycle
FETCH_BATCH_SIZE=10

# Platform settings cache TTL (seconds) — avoid hitting DB on every cycle
PLATFORM_SETTINGS_CACHE_TTL_SECONDS=30
