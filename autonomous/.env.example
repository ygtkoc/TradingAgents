# Supabase (service_role required — backend service)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Worker identity / behaviour
AUTONOMOUS_WORKER_ID=auto-local
LOG_LEVEL=INFO

# Market data
MARKET_DATA_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
MARKET_DATA_KLINE_INTERVAL=1m
MARKET_DATA_REST_FALLBACK_SECONDS=30
MARKET_DATA_HEARTBEAT_SECONDS=30
MARKET_DATA_STALE_AFTER_SECONDS=120
MARKET_DATA_BINANCE_WS_URL=wss://stream.binance.com:9443/stream
MARKET_DATA_BINANCE_REST_URL=https://api.binance.com

# Signal seeder
SIGNAL_SEEDER_INTERVAL_SECONDS=60
SIGNAL_SEEDER_MAX_AGE_MINUTES=5

# Demo-bot bootstrap
DEMO_BOOTSTRAP_ENABLED=true
DEMO_BOOTSTRAP_INTERVAL_SECONDS=30

# Health endpoint
HEALTH_PORT=9090

# Dry-run (write to DB or not)
DRY_RUN=false

# Telegram signal ingestion
# Create api_id/api_hash at https://my.telegram.org and generate a StringSession
# locally for the user's Telegram account. Keep the session secret.
TELEGRAM_INGESTION_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_STRING=
TELEGRAM_LISTENER_RELOAD_SECONDS=60
TELEGRAM_API_CORS_ORIGIN=http://localhost:3001

# ─────────────────────────────────────────────────────────────────────────────
# Email notifications (paper trade open/close)
#   EMAIL_PROVIDER=resend      → uses Resend API. requires RESEND_API_KEY.
#   EMAIL_PROVIDER=log         → logs would-be email; no delivery (default).
# ─────────────────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=TradingAgents <noreply@tradingagents.local>
EMAIL_DASHBOARD_URL=http://localhost:3001
