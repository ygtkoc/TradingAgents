# ─────────────────────────────────────────────────────────────────────────────
# Public — safe to expose in browser bundles
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_ENV=development                   # development | staging | production

# Supabase project. For DEMO_MODE you can use placeholder values
# (the client is created but never called when demo mode is on).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

NEXT_PUBLIC_MARKETING_URL=http://localhost:3000
NEXT_PUBLIC_CUSTOMER_URL=http://localhost:3001
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# ─────────────────────────────────────────────────────────────────────────────
# Demo / Test mode — visual product testing without a real backend.
#   - Bypasses auth (no /sign-in redirect).
#   - Injects a synthetic demo user.
#   - All data hooks return curated demo content (no Supabase calls).
#   - Realtime subscriptions are disabled.
#
# MUST be unset (or "false") in production deployments.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_DEMO_MODE=false

# ─────────────────────────────────────────────────────────────────────────────
# DEV-ONLY escape hatch for paper-account-create.
#
# When true AND the paper-account-create Edge Function is unreachable, the
# customer app falls back to writing the paper_accounts row directly via the
# authenticated Supabase client. Requires user-write RLS policies on
# paper_accounts. MUST stay false in production — production uses the EF.
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ALLOW_DEV_DIRECT_PAPER_ACCOUNT_WRITE=false

# ─────────────────────────────────────────────────────────────────────────────
# DO NOT add SUPABASE_SERVICE_ROLE_KEY in this file.
# The frontend MUST NEVER receive the service-role key.
# Service-role usage is reserved for backend Edge Functions only.
# ─────────────────────────────────────────────────────────────────────────────
