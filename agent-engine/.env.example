# =============================================================================
# Agent Engine — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# =============================================================================

# ── Supabase connection ───────────────────────────────────────────────────────
# Required. Get from: Supabase Dashboard > Settings > API
SUPABASE_URL=https://your-project.supabase.co

# Service role key — bypasses all RLS. Keep this secret.
# NEVER use the anon key here. NEVER log this value.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Worker identity ───────────────────────────────────────────────────────────
# Optional. Defaults to "worker-<hostname>".
# Override when running multiple replicas to track which worker processed a signal.
# WORKER_ID=worker-prod-1

# ── Processing limits ─────────────────────────────────────────────────────────
# How often to poll the signals table (seconds). Min: 2, Max: 300. Default: 10.
# POLL_INTERVAL_SECONDS=10

# Maximum concurrent pipeline runs per worker process. Default: 5.
# Increase on machines with more CPU/memory.
# MAX_CONCURRENT_RUNS=5

# Per-agent timeout (seconds). Agents exceeding this are killed. Default: 30.
# AGENT_TIMEOUT_SECONDS=30

# Full pipeline timeout (seconds). Pipelines exceeding this are killed. Default: 120.
# PIPELINE_TIMEOUT_SECONDS=120

# ── Trade decision thresholds ─────────────────────────────────────────────────
# Minimum aggregated score to open a trade (0–100). Default: 70.
# SCORE_THRESHOLD_OPEN=70.0

# Minimum score to escalate to manual review (0–100). Default: 40.
# SCORE_THRESHOLD_MANUAL_REVIEW=40.0

# ── Safety ───────────────────────────────────────────────────────────────────
# Dry run mode: pipeline runs normally, but NO database writes are made.
# Set to true during development and testing.
# DRY_RUN=false

# Maximum acceptable spread % before flagging as abnormal. Default: 2.0.
# MANIPULATION_SPREAD_THRESHOLD_PCT=2.0

# Maximum snapshot age before it's considered stale (minutes). Default: 15.
# MAX_STALE_SNAPSHOT_MINUTES=15

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR. Default: INFO.
# LOG_LEVEL=INFO

# Output format: json | console. Use json in production. Default: json.
# LOG_FORMAT=json
