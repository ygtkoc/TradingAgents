# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # service_role key — never expose to clients

# ── API Key Encryption ────────────────────────────────────────────────────────
# Must match the secret used by the Edge Function that encrypted the exchange keys.
# 32+ character random string. Rotate this to invalidate all stored keys.
API_KEY_ENCRYPTION_SECRET=your-32-char-secret-here-keep-this-safe

# ── Live Execution Gate ───────────────────────────────────────────────────────
# CRITICAL: Keep false until all safety systems are fully tested and audited.
# Setting to true enables real exchange orders for bots in live mode.
ENABLE_LIVE_EXECUTION=false

# ── Worker Identity ───────────────────────────────────────────────────────────
# Unique per worker replica. Auto-generated if not set.
EXECUTION_ENGINE_WORKER_ID=exec-worker-1

# ── Polling ───────────────────────────────────────────────────────────────────
EXECUTION_POLL_INTERVAL_SECONDS=5
EXECUTION_MAX_CONCURRENT_RUNS=3
EXECUTION_MAX_RETRIES=3
EXECUTION_STALE_MINUTES=10

# ── Queue ─────────────────────────────────────────────────────────────────────
USE_PGMQ=false

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Dry Run ───────────────────────────────────────────────────────────────────
# true = run all logic but skip all DB writes
DRY_RUN=false

# ── Pipeline timeout ─────────────────────────────────────────────────────────
PIPELINE_TIMEOUT_SECONDS=120

# ── Risk Defaults ─────────────────────────────────────────────────────────────
# Maximum age of a trade_decision before the engine refuses to execute it.
DECISION_STALE_MINUTES=60

# Percentage slippage tolerance for market orders (live only).
MAX_SLIPPAGE_PCT=1.0

# Maximum bid-ask spread percentage. Above this, execution is blocked.
MAX_SPREAD_PCT=2.0

# Whether stop-loss is required for live trades. Strongly recommended: true.
REQUIRE_STOP_LOSS_LIVE=true

# Default simulated portfolio value for paper/shadow quantity calculations.
PAPER_PORTFOLIO_VALUE_USD=10000.0
